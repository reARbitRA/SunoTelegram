# ---------------------------------------------------------------------------
# Suno Music Downloader Telegram Bot — environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values below.

# REQUIRED. Token given by @BotFather when you create the bot.
TELEGRAM_BOT_TOKEN=123456789:AAH_Your_BotFather_Token_here

# OPTIONAL. Comma separated list of Telegram user ids (integers) that are
# allowed to use the bot. Leave empty to allow everybody.
# ALLOWED_USERS=111111111,222222222

# OPTIONAL. Directory where downloaded songs and temporary files live.
DOWNLOAD_DIR=downloads

# OPTIONAL. Only users/groups whose chat id is in this list can use the bot.
# Leave empty to allow all chats.
# ALLOWED_CHAT_IDS=

# OPTIONAL. Suno cookie header value. Needed to download *private* songs that
# belong to your own account. Grab `_session` from a logged-in suno.com tab.
# SUNO_COOKIE=_session=xxxxxxxxxxxxx

# OPTIONAL. HTTP proxy (used for the HTTP / CDN / yt-dlp requests).
# HTTP_PROXY=http://127.0.0.1:7890

# OPTIONAL. Logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# OPTIONAL. Max songs accepted in a single batch before prompting.
MAX_SONGS_PER_BATCH=20
